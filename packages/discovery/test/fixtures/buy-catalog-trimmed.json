      },
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "body"
        ],
        "properties": {
          "body": {
            "type": "object",
            "description": "This scraper will let you scrape Instagram posts or reels that include the hashtag of your choice. To scrape hashtag results, just type in a <b>#️⃣ Hashtag</b>, choose <b>📝🎞️ What you want to scrape</b>, and the <b>💯 Number of results</b>. Alternatively, you could also choose to scrape by <b>🔎 Keyword instead of hashtag</b>. Then click &#9655;<b> Start </b>, and your data is on its way! <br><br>⚠️ Free usage covers just the first page of results. Upgrade to <a href='https://console.apify.com/billing/current-period' target='_blank' rel='noopener'>Starter plan</a> for full access. If you need any guidance, just <a href='https://apify.it/43PnE99' target='_blank' rel='noopener'>follow this video tutorial</a>. <br><br>🎞️ If you would like to scrape reels in more detail, go for our <a href='https://console.apify.com/actors/xMc5Ga1oCONPmWJIa/input' target='_blank' rel='noopener'>Instagram Reel Scraper</a>. <br>🔥 If you would like to find popular reels by search (new feature), go for our <a href='https://console.apify.com/actors/DrF9mzPPEuVizVF4l/input' target='_blank' rel='noopener'>Instagram Search Scraper</a>. <br>📊 If you would like to discover what other hashtags are out there for your topic + their reach, go for our <a href='https://console.apify.com/actors/cHedUknx10dsaavpI' target='_blank' rel='noopener'>Instagram Analytics Scraper</a>.",
            "properties": {
              "hashtags": {
                "type": "array",
                "description": "Type in or paste the hashtag with or without <code>#</code> symbol.<br><br> ⚠️ Each hashtag is treated as <strong>one single search term</strong>. If you put several words in one line (e.g. <code>travel photography food</code>), they'll be merged into a single hashtag (<code>#travelphotographyfood</code>). To search for terms separately, add each one as its own entry using the <strong>&#43; Add</strong> button — and use keyword search if you need multi-word phrases. <br><br>🔎 <strong>Searching by keyword?</strong> Add your keywords in this same field, then enable <strong>Scrape with a keyword instead of hashtag</strong> toggle below. You can add as many keywords as you like in one field, space-separated.",
                "items": {
                  "type": "string",
                  "pattern": "^\\s*#?[^!?.,:;\\-+=*&%$#@/\\~^|<>()[\\]{}\"'`]+$"
                }
              },
              "keywordSearch": {
                "type": "boolean",
                "description": "Enable this option if you want to get posts or reels by a specific keyword instead of a hashtag. Add your keywords to the <strong>Hashtags or keywords</strong> field above. Unlike with hashtags, <b>multiple words are supported as keywords</b>, just add spaces between them. The dataset will be slightly different than the one produced by hashtag. <a href='https://apify.com/apify/instagram-hashtag-scraper#what-is-the-difference-between-extracting-instagram-data-by-hashtag-and-by-keyword' target='_blank' rel='noopener'>See examples here</a> with the difference between hashtag and keyword extraction."
              },
              "resultsType": {
                "type": "string",
                "description": "Choose whether to scrape posts or reels for the selected hashtags or keywords.",
                "enum": [
                  "posts",
                  "reels",
                  "stories"
                ],
                "default": "posts"
              },
              "resultsLimit": {
                "type": "integer",
                "description": "Set the maximum number of results (reels or posts) you want to scrape. If you set this to <code>5</code>, you will scrape 5 posts for each hashtag or keyword you provide. With this setup, if you decide to add <code>7</code> different hashtags or keywords, you will scrape <code>35</code> posts altogether.<br><br>⚠️ Free usage covers just the first page of results. To get more pages, <a href='https://console.apify.com/billing/current-period' target='_blank' rel='noopener'>Upgrade your plan</a>.",
                "minimum": 1
              }
            },
            "required": [
              "hashtags"
            ],
            "additionalProperties": false
          }
        }
