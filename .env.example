# Copy to .env (never commit .env). Keys live here or in a secret store only.

# dev = sepolia, evidence = mainnet
RAILWALKER_NETWORK=sepolia
RAILWALKER_REPO=JemIIahh/railwalker

# ERC-8021 code assigned at Loops enrollment. Expected: celo_29928c447ace
RAILWALKER_ATTRIBUTION_CODE=

# Agent wallet (hot wallet, hold at most $3). Generate with: railwalker wallet:new
AGENT_PRIVATE_KEY=
# Set after `railwalker register`
RAILWALKER_AGENT_ID=

# Optional overrides
CELO_RPC_URL=
SELLER_PAY_TO=
FIXTURE_PAY_TO=

# Facilitator metering key (created by a human at https://x402.celo.org)
X402_API_KEY=

# Secret salt for hashing unsolicited seller hosts in public data
SELLER_SALT=

# Local data directory used by the batch runner and the web app in development
DATA_DIR=./data
